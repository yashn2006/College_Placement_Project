<div class="card">
    <div class="flex justify-between items-center mb-4">
        <h3 class="title">{{this.title}}</h3>
        <span class="badge badge-gray">{{this.type}}</span>
    </div>
    <p class="mb-4" style="color: var(--text-muted); font-size: 0.9rem;">
        {{#if this.companies}}
            <strong>Company:</strong> {{this.companies.name}}<br>
        {{/if}}
        <strong>Deadline:</strong> {{formatDate this.deadline}}
    </p>
    <div class="flex justify-between items-center">
        <span style="font-weight: 600; color: var(--secondary);">{{this.ctc_or_stipend}}</span>
        <a href="/job/{{this.id}}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.8rem;">Details</a>
    </div>
</div>
