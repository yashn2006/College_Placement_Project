<div class="container">
    <div style="text-align: center; margin: 4rem 0;">
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">College Placement Portal</h1>
        <p style="color: var(--text-muted); font-size: 1.25rem;">Connecting students with top-tier career opportunities.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-number">{{stats.companies}}</span>
            <span class="stat-label">Companies</span>
        </div>
        <div class="stat-card">
            <span class="stat-number">{{stats.jobs}}</span>
            <span class="stat-label">Open Jobs</span>
        </div>
        <div class="stat-card">
            <span class="stat-number">{{stats.students}}</span>
            <span class="stat-label">Students</span>
        </div>
    </div>
</div>
